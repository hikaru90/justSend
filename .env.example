# Database (SQLite; default path used by compose + supervisor)
DATABASE_URL=file:./data/owlery.db

# App — AUTH_SECRET must be >= 16 characters (validated at boot via zod)
HOST_URL=http://localhost:5173
AUTH_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# Admin (optional — grants admin UI access when it matches the signed-in email)
ADMIN_EMAIL=admin@example.com

# Magic link email (optional — logs link to console if unset)
FROM_EMAIL=

# OAuth (optional)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS / SES (required to actually send; dashboard works without them in development)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_SES_ENDPOINT=
AWS_SNS_ENDPOINT=

# Rate limits
API_RATE_LIMIT=10
AUTH_EMAIL_RATE_LIMIT=5

# AI / OpenRouter (template generation + Pi.dev)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Pi.dev coding agent (SDK connection layer; reuses OpenRouter auth)
# PI_ENABLED=  # unset = on when OPENROUTER_API_KEY is set; false/0 to disable
PI_AGENT_DIR=./data/pi/agent
# PI_MODEL=  # optional override; defaults to OPENROUTER_MODEL

# MCP — agents use HTTP endpoint /mcp with Bearer API key (or stdio: npm run mcp)
# OWLERY_API_KEY / OWLERY_DOMAIN_ID only needed for the stdio server
OWLERY_API_KEY=
OWLERY_DOMAIN_ID=

# Optional
DISCORD_WEBHOOK_URL=
EMAIL_CLEANUP_DAYS=
