# Database
DATABASE_URL=file:./data/owlery.db

# App
HOST_URL=http://localhost:5173
AUTH_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# Admin (optional — grants admin UI access)
ADMIN_EMAIL=admin@example.com

# Magic link email (optional — logs link to console if unset)
FROM_EMAIL=

# OAuth (optional)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS / SES
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_SES_ENDPOINT=
AWS_SNS_ENDPOINT=

# Rate limits
API_RATE_LIMIT=10
AUTH_EMAIL_RATE_LIMIT=5

# AI / OpenRouter (template generation)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional
DISCORD_WEBHOOK_URL=
EMAIL_CLEANUP_DAYS=
