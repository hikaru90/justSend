{
  "name": "owlery",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/build-worker.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev:app": "vite dev",
    "dev:worker": "tsx watch src/server/worker.ts",
    "dev:all": "concurrently -n app,worker -c blue,green \"pnpm dev:app\" \"pnpm dev:worker\"",
    "worker": "tsx src/server/worker.ts",
    "worker:prod": "node build/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:pull": "node scripts/pull-db.mjs",
    "db:export-parts": "tsx scripts/export-parts.ts",
    "db:import-parts": "tsx scripts/import-parts.ts",
    "start": "node scripts/supervisor.mjs",
    "start:web": "node build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.2.0",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "resolve": "^1.22.12",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1095.0",
    "@aws-sdk/client-sns": "^3.1095.0",
    "@aws-sdk/client-sts": "^3.1095.0",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@lucide/svelte": "^1.27.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@usewaypoint/block-avatar": "^0.0.3",
    "@usewaypoint/block-button": "^0.0.3",
    "@usewaypoint/block-columns-container": "^0.0.3",
    "@usewaypoint/block-container": "^0.0.2",
    "@usewaypoint/block-divider": "^0.0.4",
    "@usewaypoint/block-heading": "^0.0.3",
    "@usewaypoint/block-html": "^0.0.3",
    "@usewaypoint/block-image": "^0.0.5",
    "@usewaypoint/block-spacer": "^0.0.3",
    "@usewaypoint/block-text": "^0.0.7",
    "@usewaypoint/document-core": "^0.0.6",
    "@usewaypoint/email-builder": "^0.0.9",
    "@xyflow/svelte": "^1.6.2",
    "arctic": "^3.7.0",
    "better-sqlite3": "^13.0.1",
    "bits-ui": "^2.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "^3.19.0",
    "juice": "^12.1.1",
    "marked": "^18.0.7",
    "mode-watcher": "^1.1.0",
    "nanoid": "^6.0.0",
    "nodemailer": "^9.0.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.9",
    "zod": "^4.4.3"
  }
}
