{
  "name": "justsend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev:app": "vite dev",
    "dev:worker": "tsx watch src/server/worker.ts",
    "dev:all": "concurrently -n app,worker -c blue,green \"pnpm dev:app\" \"pnpm dev:worker\"",
    "worker": "tsx src/server/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "start": "node build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "resolve": "^1.22.12",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1095.0",
    "@aws-sdk/client-sns": "^3.1095.0",
    "@aws-sdk/client-sts": "^3.1095.0",
    "@lucide/svelte": "^1.27.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "arctic": "^3.7.0",
    "better-sqlite3": "^13.0.1",
    "bits-ui": "^2.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "mode-watcher": "^1.1.0",
    "nanoid": "^6.0.0",
    "nodemailer": "^9.0.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.9",
    "zod": "^4.4.3"
  }
}
